meta {
  name: 6. Logout
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("returns 204 No Content", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Thu hồi refresh token của thiết bị hiện tại. Sau khi logout, chạy
  "3. Refresh Token - Valid" sẽ nhận 401.

  Backend luôn trả 204 (kể cả token sai hoặc đã thu hồi) để không lộ trạng thái token.
  Lưu ý: access token vẫn dùng được đến khi hết hạn (mặc định 15 phút) vì JWT là stateless.
}
