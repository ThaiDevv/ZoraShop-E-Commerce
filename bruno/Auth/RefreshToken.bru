meta {
  name: 3. Refresh Token - Valid
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh-token
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:pre-request {
  // Keep the token being rotated so "Refresh Token - Reused" can replay it
  bru.setEnvVar("usedRefreshToken", bru.getEnvVar("refreshToken"));
}

script:post-response {
  const data = res.getBody()?.body;
  if (res.getStatus() === 200 && data?.accessToken) {
    bru.setEnvVar("accessToken", data.accessToken);
    bru.setEnvVar("refreshToken", data.refreshToken);
  }
}

tests {
  test("returns 200 with a new token pair", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().body.accessToken).to.be.a("string");
    expect(res.getBody().body.refreshToken).to.be.a("string");
  });

  test("refresh token is rotated", function() {
    expect(res.getBody().body.refreshToken).to.not.equal(bru.getEnvVar("usedRefreshToken"));
  });
}

docs {
  Chạy "2. Login User" trước. Request đổi refresh token hiện tại lấy cặp token mới
  (rotation) và tự lưu lại accessToken / refreshToken. Token vừa bị thay được giữ
  trong biến usedRefreshToken để dùng cho case "Reused".
}
