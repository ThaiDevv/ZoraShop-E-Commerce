meta {
  name: 2. Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "buyer@zorashop.com",
    "password": "Password123@"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    if (res.body.data.accessToken) {
      bru.setVar("accessToken", res.body.data.accessToken);
    }
    if (res.body.data.refreshToken) {
      bru.setVar("refreshToken", res.body.data.refreshToken);
    }
  }
}
