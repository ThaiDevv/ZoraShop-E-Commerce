meta {
  name: 2. Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "buyer1@zorashop.com",
    "password": "Password123@"
  }
}

script:post-response {
  // ApiResponse wraps the payload in "body"; save tokens so other requests can use {{accessToken}} / {{refreshToken}}
  const data = res.getBody()?.body;
  if (data?.accessToken) {
    bru.setEnvVar("accessToken", data.accessToken);
  }
  if (data?.refreshToken) {
    bru.setEnvVar("refreshToken", data.refreshToken);
  }
}

tests {
  test("returns 200 with access and refresh tokens", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().body.accessToken).to.be.a("string");
    expect(res.getBody().body.refreshToken).to.be.a("string");
  });
}
