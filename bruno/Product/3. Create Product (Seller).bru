meta {
  name: 3. Create Product (Seller)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/seller/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
